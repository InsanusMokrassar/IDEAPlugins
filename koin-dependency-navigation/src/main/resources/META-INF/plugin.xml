<idea-plugin>
    <id>dev.inmo.idea.koin.dependency.navigation</id>
    <name>Koin Dependency Navigation</name>
    <vendor>InMo</vendor>
    <description><![CDATA[
        Navigate between Kotlin Koin definitions and injection calls from the editor gutter.
        Supports binding aliases, qualifiers, inferred types and direct forwarding wrappers.
        Uses Kotlin K2 analysis.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.kotlin</depends>
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="false" supportsK2="true"/>
    </extensions>
    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="dev.inmo.idea.koin.dependency.navigation.DiIndexStartupActivity"/>
        <codeInsight.lineMarkerProvider language="kotlin"
            implementationClass="dev.inmo.idea.koin.dependency.navigation.DiLineMarkerProvider"/>
        <fileBasedIndex implementation="dev.inmo.idea.koin.dependency.navigation.DiCallIndex"/>
    </extensions>
</idea-plugin>
