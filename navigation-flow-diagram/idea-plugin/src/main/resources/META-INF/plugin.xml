<idea-plugin>
    <id>dev.inmo.idea.navigation.flow.diagram</id>
    <name>Navigation Flow Diagram</name>
    <vendor>InMo</vendor>
    <description><![CDATA[
        Find places where dev.inmo.navigation creates Views by tracing their configurations.
        Navigate from View/config declarations to push, replace and other allocation calls.
        Inspect and export a project navigation diagram using a shared standalone analyzer.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.kotlin</depends>
    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="dev.inmo.idea.navigation.flow.diagram.NavigationStartupActivity"/>
        <codeInsight.lineMarkerProvider language="kotlin"
            implementationClass="dev.inmo.idea.navigation.flow.diagram.NavigationLineMarkerProvider"/>
        <toolWindow id="Navigation Flow Diagram" anchor="right" icon="/icons/allocation.svg"
            factoryClass="dev.inmo.idea.navigation.flow.diagram.NavigationToolWindowFactory"/>
    </extensions>
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="false" supportsK2="true"/>
    </extensions>
</idea-plugin>
